{
    // Absolute or ~ -expanded path to the single notes file.
    "notes_file": "~/Documents/ST4Notes",

    // notes_file must resolve under this directory (default: home).
    // Raise intentionally only if you keep notes outside $HOME.
    "notes_path_jail": "~",

    // YouTrack issue browser base URL (https required; trailing slash recommended).
    // Example: "https://youtrack.example.com/issue/"
    "youtrack_base": "",

    // Permanent API token. Prefer setting this only in
    // Packages/User/ST4Notes.sublime-settings — never commit a real token.
    // Keep this package default empty. YouTrack → Profile → Authentication → New token
    // Scopes: Read Issue, Create Issue, Update Issue, Create Comment
    "youtrack_token": "",

    // GitLab base URL for MR hover (https required). Example: "https://gitlab.example.com/"
    "gitlab_base": "",

    // GitLab personal access token (api / read_api). User settings only — never commit.
    // Keep this package default empty.
    "gitlab_token": "",

    // Default YouTrack project shortName (issue create / import / TODO list).
    "default_project": "",

    // Stage names offered when creating stage sub-tasks.
    // Leave [] to be prompted at creation time.
    // Example: ["Design", "Dev", "QA", "Deploy"]
    "issue_stages": [],

    // When true, Notes - Add also posts the note text as a YouTrack comment.
    "post_comments": false,

    // Multi-line note limits (Notes: Add description scratch)
    "note_max_lines": 50,
    "note_max_line_len": 500,

    "api_timeout_sec": 10,
    "api_max_retries": 2
}
