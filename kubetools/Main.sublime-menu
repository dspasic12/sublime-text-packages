[
    {
        "id": "tools",
        "children": [
            {
                "caption": ".kubetools",
                "id": "kubetools",
                "children": [
                    {
                        "caption": "Hub…",
                        "command": "kubetools_hub"
                    },
                    {
                        "caption": "Create…",
                        "command": "kubetools_create"
                    },
                    {
                        "caption": "-"
                    },
                    {
                        "caption": "Compare State",
                        "command": "kubetools_compare_state"
                    },
                    {
                        "caption": "Next Diff",
                        "command": "kubetools_next_diff"
                    },
                    {
                        "caption": "Prev Diff",
                        "command": "kubetools_prev_diff"
                    },
                    {
                        "caption": "Copy Live Under Caret",
                        "command": "kubetools_copy_live_under_caret"
                    },
                    {
                        "caption": "Clear Compare Overlays",
                        "command": "kubetools_clear_compare"
                    },
                    {
                        "caption": "Apply Open File",
                        "command": "kubetools_open_file"
                    },
                    {
                        "caption": "Dry-Run Open File",
                        "command": "kubetools_dry_run_open_file"
                    },
                    {
                        "caption": "-"
                    },
                    {
                        "caption": "Seal (selection or file)",
                        "command": "kubetools_seal"
                    },
                    {
                        "caption": "Unseal Selected Text",
                        "command": "kubetools_unseal"
                    },
                    {
                        "caption": "-"
                    },
                    {
                        "caption": "Settings…",
                        "command": "kubetools_open_settings"
                    }
                ]
            }
        ]
    },
    {
        "caption": "Preferences",
        "mnemonic": "n",
        "id": "preferences",
        "children": [
            {
                "caption": "Package Settings",
                "mnemonic": "P",
                "id": "package-settings",
                "children": [
                    {
                        "caption": "Kubetools",
                        "children": [
                            {
                                "caption": "Settings",
                                "command": "kubetools_open_settings"
                            },
                            {
                                "caption": "Settings – Default",
                                "command": "open_file",
                                "args": {
                                    "file": "${packages}/kubetools/Kubetools.sublime-settings"
                                }
                            },
                            {
                                "caption": "Settings – User",
                                "command": "open_file",
                                "args": {
                                    "file": "${packages}/User/Kubetools.sublime-settings"
                                }
                            },
                            {
                                "caption": "Key Bindings",
                                "command": "edit_settings",
                                "args": {
                                    "base_file": "${packages}/kubetools/Default.sublime-keymap",
                                    "user_file": "${packages}/User/Default (${platform}).sublime-keymap",
                                    "default": "[\n\t$0\n]\n"
                                }
                            }
                        ]
                    }
                ]
            }
        ]
    }
]
