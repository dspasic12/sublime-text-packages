{
    // Kubetools — Preferences → Package Settings → Kubetools → Settings
    // Sublime Text 4 Build 4205+ (Python 3.14 plugin host) on macOS, Windows, Linux.
    // Sublime merges Default (this file) + User (right pane).
    // Paths support ${home}, ${packages}, and ~ expansion.
    // Put kubectl/kubeseal paths, context aliases, and every seal stage
    // (cert / private key) only in Packages/User/Kubetools.sublime-settings.

    // --- Binaries -----------------------------------------------------------
    // Sublime's GUI PATH is often thinner than a terminal login shell.
    // If Compare/Apply/Seal says kubectl/kubeseal not found, set absolute paths
    // here in the User overlay (right pane), for example:
    //   macOS Homebrew: "/opt/homebrew/bin/kubectl"
    //   Linux user/krew: "~/.local/bin/kubectl"  or  "/usr/bin/kubectl"
    //   Ubuntu snap:     "/snap/bin/kubectl"
    //   Windows:         "C:\\Program Files\\Docker\\Docker\\resources\\bin\\kubectl.exe"
    // Bare "kubectl" / empty kubeseal_path still search PATH plus ~/.local/bin,
    // /snap/bin, Homebrew, Scoop, and Chocolatey.
    "kubectl_path": "kubectl",
    "kubeseal_path": "",

    // Seconds before kubectl / kubeseal commands time out
    "timeout": 60,

    // --- Apply safety (hard-locked ON in code; listed for documentation) ----
    "always_pass_context": true,
    "dry_run_before_apply": true,
    "require_confirmation": true,

    // Show kubectl diff (or "new resource") before apply confirmation
    "show_diff_before_apply": true,

    // Extra confirm when kubectl context / seal stage name matches any pattern.
    // Patterns support * wildcards; matching is case-insensitive.
    "dangerous_context_patterns": [
        "*prod*",
        "*production*",
        "*-prod-*",
        "prod-*",
        "*prd*",
        "*live*"
    ],
    "dangerous_context_require_type_name": true,

    // Pre-highlight kubectl context from the open file path (exact segment /
    // environments/<env>/<cluster>/). NEVER skips the context quick panel.
    "guess_context_from_path": true,

    // Optional map when folder name ≠ kubectl context, e.g.
    // { "my-cluster": "org-my-cluster" }  — User overlay only
    "context_path_aliases": {},

    "warn_unsaved_buffer": true,
    "warn_secret_resources": true,
    "require_secret_confirm": true,
    "block_on_unverified_resources": true,

    // Soft caps (raise only intentionally)
    "max_resources": 50,
    "max_manifest_bytes": 2097152,

    // Namespace picker: "quick_panel" | "input"
    "namespace_picker": "quick_panel",
    "default_namespace": "default",

    // kubectl apply
    "validate": true,
    "server_side_apply": false,
    "field_manager": "sublime-kubetools",

    // Results always open in a scratch tab (macOS ST4-safe)
    "show_result_in_tab": true,

    // --- Seal / unseal (kubeseal) ------------------------------------------
    // Configure stages only in User settings. Keep this list empty.
    // If User/Kubetools stages is empty, leftover User/Kubeseal.sublime-settings
    // is a one-time migration fallback — leave that file's stages [] after moving.
    //
    // Example User entry (paths are yours — do not commit them here):
    // {
    //     "name": "my-cluster",
    //     "description": "dev cluster (encrypt + optional decrypt)",
    //     "cert_path": "${home}/path/to/environments/dev/my-cluster/sealed-secrets/pub.pem",
    //     "private_key_path": "${home}/path/to/environments/dev/my-cluster/sealed-secrets/priv.key"
    // }
    "stages": [],

    // Pre-select this stage when the open file path does not imply one
    "default_stage": "",

    // true in defaults; hard-locked ON in code — stage panel always shown
    "ask_stage_every_time": true,

    // Updated automatically when you pick a stage (written to User overlay)
    "last_stage": "",

    // Unseal output: "new_tab" | "popup"
    "decrypt_output": "new_tab",
    // After unseal, base64-decode Secret.data for readability
    "decode_secret_data": true,
    "validate_k8s_names": true,
    // Confirm before re-encrypting selections that already look sealed
    "confirm_reseal_selection": true,
    // Confirm before overwriting an existing *-sealedsecret.yaml (.bckp-* backup)
    "confirm_overwrite_sealed": true,
    // After full-file seal, offer Compare State on the sealed file
    "offer_compare_after_seal": true,
    "max_selections": 10,
    "default_secret_name": "mysecret",

    // Legacy single-key fallback (only when "stages" is empty)
    "cert_path": "",
    "private_key_path": ""
}
