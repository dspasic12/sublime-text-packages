[
    // Keyboard-first chords (ctrl+k then letter). Scoped to YAML/JSON so they
    // do not steal Sublime's global ctrl+k chords in other syntaxes.
    // Remap: Preferences → Package Settings → Kubetools → Key Bindings.
    {
        "keys": ["ctrl+k", "ctrl+h"],
        "command": "kubetools_hub",
        "context": [
            { "key": "selector", "operator": "equal", "operand": "source.yaml, source.json" }
        ]
    },
    {
        "keys": ["ctrl+k", "ctrl+c"],
        "command": "kubetools_compare_state",
        "context": [
            { "key": "selector", "operator": "equal", "operand": "source.yaml, source.json" }
        ]
    },
    {
        "keys": ["ctrl+k", "ctrl+d"],
        "command": "kubetools_dry_run_open_file",
        "context": [
            { "key": "selector", "operator": "equal", "operand": "source.yaml, source.json" }
        ]
    },
    {
        "keys": ["ctrl+k", "ctrl+a"],
        "command": "kubetools_open_file",
        "context": [
            { "key": "selector", "operator": "equal", "operand": "source.yaml, source.json" }
        ]
    },
    {
        "keys": ["ctrl+k", "ctrl+s"],
        "command": "kubetools_seal",
        "context": [
            { "key": "selector", "operator": "equal", "operand": "source.yaml, source.json" }
        ]
    },
    {
        "keys": ["ctrl+k", "ctrl+u"],
        "command": "kubetools_unseal",
        "context": [
            { "key": "selector", "operator": "equal", "operand": "source.yaml, source.json" }
        ]
    },
    {
        "keys": ["ctrl+k", "ctrl+x"],
        "command": "kubetools_clear_compare",
        "context": [
            { "key": "selector", "operator": "equal", "operand": "source.yaml, source.json" }
        ]
    },
    {
        "keys": ["ctrl+k", "ctrl+n"],
        "command": "kubetools_next_diff",
        "context": [
            { "key": "selector", "operator": "equal", "operand": "source.yaml, source.json" }
        ]
    },
    {
        "keys": ["ctrl+k", "ctrl+p"],
        "command": "kubetools_prev_diff",
        "context": [
            { "key": "selector", "operator": "equal", "operand": "source.yaml, source.json" }
        ]
    },
    {
        "keys": ["ctrl+k", "ctrl+y"],
        "command": "kubetools_copy_live_under_caret",
        "context": [
            { "key": "selector", "operator": "equal", "operand": "source.yaml, source.json" }
        ]
    },
    {
        "keys": ["ctrl+k", "ctrl+,"],
        "command": "kubetools_open_settings"
    }
]
